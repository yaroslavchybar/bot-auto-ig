{
  "name": "anti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run build:rust && bun run --filter anti-server build",
    "dev": "concurrently -n server,frontend,convex -c green,magenta,yellow \"bun run --filter anti-server dev\" \"bun run --filter frontend dev\" \"bunx convex dev\"",
    "dev:server": "bun run --filter anti-server dev",
    "start": "bun run --filter anti-server start",
    "test:convex": "vp test run",
    "typecheck": "bun run --filter anti-server typecheck && bun run --filter frontend typecheck && tsc -p convex/tsconfig.json --noEmit",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "build:rust": "cargo build --release --workspace --locked"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.60",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
