{
  "name": "anti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run build:rust && bun run --filter anti-server build",
    "dev": "bun run --parallel --no-orphans dev:server dev:frontend dev:convex",
    "dev:server": "bun run --filter anti-server dev",
    "dev:frontend": "bun run --filter frontend dev",
    "dev:convex": "bunx convex dev",
    "start": "bun run --filter anti-server start",
    "test:convex": "vp test run",
    "test:server": "bun --no-orphans test --parallel=2 server",
    "typecheck": "bun run --filter anti-server typecheck && bun run --filter frontend typecheck && bun check -p convex/tsconfig.json",
    "lint": "vp lint .",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "build:rust": "cargo build --release --workspace --locked"
  },
  "dependencies": {
    "convex": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "convex-test": "0.0.64",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
