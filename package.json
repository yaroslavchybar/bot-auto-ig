{
  "name": "anti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run --filter anti-server build",
    "dev": "concurrently -n server,frontend,convex -c green,magenta,yellow \"bun run --filter anti-server dev\" \"bun run --filter frontend dev\" \"bunx convex dev\"",
    "dev:server": "bun run --filter anti-server dev",
    "start": "bun run --filter anti-server start",
    "test:convex": "bunx vitest run --config vitest.convex.config.ts",
    "typecheck": "bun run --filter anti-server typecheck && bun run --filter frontend typecheck && tsc -p convex/tsconfig.json --noEmit",
    "lint": "bun run --filter frontend lint"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.58",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.0.18",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
